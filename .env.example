# ==============================================================================
# Settl — Environment Variables Configuration
# ==============================================================================

# Database & Supabase PostgreSQL
# Connect to your Supabase PostgreSQL database URL or use local sqlite for offline development
DATABASE_URL=sqlite:///./settl.db
# Example Supabase pooled connection string:
# DATABASE_URL=postgresql+psycopg://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Test Mode Credentials (Backend only — Never expose to browser)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Authentication & Security
SECRET_KEY=settl_super_secret_jwt_key_min_32_characters_long_for_hs256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Structured Outputs (Phase 3)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Server & App Config
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
